{
  "name": "@opencard/feedback-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "types": "wrangler types --env-file .dev.vars.example --strict-vars=false --include-runtime=false",
    "types:check": "wrangler types --check --env-file .dev.vars.example --strict-vars=false --include-runtime=false",
    "check": "npm run types:check && tsc --noEmit",
    "test": "vitest run",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260731.1",
    "@types/node": "^26.1.2",
    "typescript": "^5.6.2",
    "vitest": "^4.1.4",
    "wrangler": "^4.36.0"
  }
}
