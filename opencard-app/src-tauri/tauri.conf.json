{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenCard",
  "version": "0.2.8",
  "identifier": "per.yiguwang.opencard",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OpenCard",
        "decorations": false,
        "minWidth": 1280,
        "minHeight": 720,
        "width": 1280,
        "height": 720
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "shortDescription": "Visual card design and template workspace",
    "longDescription": "OpenCard is a visual workspace for designing cards, managing reusable templates, and exporting finished card assets.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "opencard"
        ],
        "name": "OpenCard Card Document",
        "description": "OpenCard card document",
        "mimeType": "application/vnd.opencard.card+json",
        "role": "Editor",
        "rank": "Owner",
        "exportedType": {
          "identifier": "per.yiguwang.opencard.card",
          "conformsTo": [
            "public.json"
          ]
        }
      },
      {
        "ext": [
          "opencardproject"
        ],
        "name": "OpenCard Project File",
        "description": "OpenCard project file",
        "mimeType": "application/vnd.opencard.project+json",
        "role": "Editor",
        "rank": "Owner",
        "exportedType": {
          "identifier": "per.yiguwang.opencard.project",
          "conformsTo": [
            "public.json"
          ]
        }
      },
      {
        "ext": [
          "opencardtemplate"
        ],
        "name": "OpenCard Project Template",
        "description": "OpenCard project template package",
        "mimeType": "application/vnd.opencard.project-template+zip",
        "role": "Editor",
        "rank": "Owner",
        "exportedType": {
          "identifier": "per.yiguwang.opencard.project-template",
          "conformsTo": [
            "public.zip-archive"
          ]
        }
      }
    ],
    "resources": {
      "resources/templates/": "templates/"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE1NzYwNjI3MkVDQkU0QkEKUldTNjVNc3VKd1oycGZncGQveWlSUGUvZ1BDQk5IcndhYy9JMjE0bzF2Sll2aEN0dHFHR0xNOGgK",
      "endpoints": [
        "https://github.com/POPCORNBOOM/OpenCard/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
