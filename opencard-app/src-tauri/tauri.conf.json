{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "opencard",
  "version": "0.2.0",
  "identifier": "per.yiguwang.opencard",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OpenCard",
        "decorations": false,
        "minWidth": 1280,
        "minHeight": 720,
        "width": 1280,
        "height": 720
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Visual card design and template workspace",
    "longDescription": "OpenCard is a visual workspace for designing cards, managing reusable templates, and exporting finished card assets.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/templates/": "templates/"
    }
  }
}
