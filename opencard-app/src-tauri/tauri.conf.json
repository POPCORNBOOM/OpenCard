{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenCard",
  "version": "0.4.4",
  "identifier": "per.yiguwang.opencard",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OpenCard",
        "decorations": false,
        "minWidth": 1280,
        "minHeight": 720,
        "width": 1280,
        "height": 720
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "shortDescription": "Visual card design and template workspace",
    "longDescription": "OpenCard is a visual workspace for designing cards, managing reusable templates, and exporting finished card assets.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "ocdocument"
        ],
        "name": "OpenCard Card Document",
        "description": "OpenCard card document",
        "mimeType": "application/vnd.opencard.card+json",
        "role": "Editor",
        "rank": "Owner",
        "exportedType": {
          "identifier": "per.yiguwang.opencard.card",
          "conformsTo": [
            "public.json"
          ]
        }
      },
      {
        "ext": [
          "ocproject"
        ],
        "name": "OpenCard Project Configuration",
        "description": "OpenCard project configuration",
        "mimeType": "application/vnd.opencard.project-configuration+json",
        "role": "Editor",
        "rank": "Owner",
        "exportedType": {
          "identifier": "per.yiguwang.opencard.project-configuration",
          "conformsTo": [
            "public.json"
          ]
        }
      },
      {
        "ext": [
          "ocfonts"
        ],
        "name": "OpenCard Project Font Registry",
        "description": "OpenCard project font registry",
        "mimeType": "application/vnd.opencard.project-font-registry+json",
        "role": "Editor",
        "rank": "Owner",
        "exportedType": {
          "identifier": "per.yiguwang.opencard.project-font-registry",
          "conformsTo": [
            "public.json"
          ]
        }
      },
      {
        "ext": [
          "ocicons"
        ],
        "name": "OpenCard Project Icon Registry",
        "description": "OpenCard project icon registry",
        "mimeType": "application/vnd.opencard.project-icon-registry+json",
        "role": "Editor",
        "rank": "Owner",
        "exportedType": {
          "identifier": "per.yiguwang.opencard.project-icon-registry",
          "conformsTo": [
            "public.json"
          ]
        }
      },
      {
        "ext": [
          "oclocale"
        ],
        "name": "OpenCard Project Global Dictionary",
        "description": "OpenCard project global dictionary",
        "mimeType": "application/vnd.opencard.project-global-dictionary+json",
        "role": "Editor",
        "rank": "Owner",
        "exportedType": {
          "identifier": "per.yiguwang.opencard.project-global-dictionary",
          "conformsTo": [
            "public.json"
          ]
        }
      },
      {
        "ext": [
          "ocblocks"
        ],
        "name": "OpenCard Custom Block Registry",
        "description": "OpenCard custom block registry",
        "mimeType": "application/vnd.opencard.custom-block-registry+json",
        "role": "Editor",
        "rank": "Owner",
        "exportedType": {
          "identifier": "per.yiguwang.opencard.custom-block-registry",
          "conformsTo": [
            "public.json"
          ]
        }
      },
      {
        "ext": [
          "ocblock"
        ],
        "name": "OpenCard Custom Block",
        "description": "OpenCard custom block package",
        "mimeType": "application/vnd.opencard.custom-block+zip",
        "role": "Editor",
        "rank": "Owner",
        "exportedType": {
          "identifier": "per.yiguwang.opencard.custom-block",
          "conformsTo": [
            "public.zip-archive"
          ]
        }
      },
      {
        "ext": [
          "octemplate"
        ],
        "name": "OpenCard Project Template",
        "description": "OpenCard project template package",
        "mimeType": "application/vnd.opencard.project-template+zip",
        "role": "Editor",
        "rank": "Owner",
        "exportedType": {
          "identifier": "per.yiguwang.opencard.project-template",
          "conformsTo": [
            "public.zip-archive"
          ]
        }
      },
      {
        "ext": [
          "ociconpack"
        ],
        "name": "OpenCard Icon Pack",
        "description": "OpenCard icon pack",
        "mimeType": "application/vnd.opencard.icon-pack+zip",
        "role": "Editor",
        "rank": "Owner",
        "exportedType": {
          "identifier": "per.yiguwang.opencard.icon-pack",
          "conformsTo": [
            "public.zip-archive"
          ]
        }
      }
    ],
    "resources": {
      "resources/templates/": "templates/",
      "resources/icon-packs/": "icon-packs/"
    }
  },
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": false
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE1NzYwNjI3MkVDQkU0QkEKUldTNjVNc3VKd1oycGZncGQveWlSUGUvZ1BDQk5IcndhYy9JMjE0bzF2Sll2aEN0dHFHR0xNOGgK",
      "endpoints": [
        "https://github.com/POPCORNBOOM/OpenCard/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
