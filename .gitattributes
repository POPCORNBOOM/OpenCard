# Keep source and configuration files consistent across platforms.
* text=auto eol=lf

# Binary assets must never be line-ending normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.zip binary
*.ocpack binary
*.exe binary
*.dll binary
*.dylib binary
*.so binary
